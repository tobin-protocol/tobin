# Tobin Clearing Protocol: the SDK and CLI are planned in TypeScript (Node), so this covers
# that stack plus secrets, editor/OS files and Soroban contract build output (target/).

# dependencies
node_modules/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output
dist/
build/
out/
*.tsbuildinfo

# tests and coverage
coverage/
.nyc_output/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# secrets and keys: never commit these (Stellar secret keys, tokens, certificates)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# local caches
.cache/
.eslintcache
.turbo/

# editor and OS files
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# MVP-1 local-only and generated paths (added during the MVP-1 migration)
target/
apps/web-console/test/browser/.badge-profile/
apps/web-console/test/browser/shots/
/archive/
phase-e-evidence/

# Next.js build output and generated files
.next/
next-env.d.ts
*.tsbuildinfo

# Landing page source images (originals, background-removed PNGs and Unsplash downloads). The optimised
# files actually served live in apps/landing/public/; the sources are never committed.
apps/landing/assets-src/
