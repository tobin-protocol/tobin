{
  "name": "tobin-web-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tobin MVP-1 local-sandbox Console on Next.js (App Router). Experimental; local only: binds to 127.0.0.1, talks to no Stellar network, signs nothing.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 8787",
    "build": "next build",
    "build:console": "next build",
    "start": "next start --hostname 127.0.0.1 --port 8787",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "test:unit": "node --test test/guards.test.ts test/api.test.ts test/console-view.test.ts test/console-input.test.ts",
    "test:browser": "node test/browser/journey.mjs",
    "test:w0-browser": "node test/browser/w0-journey.mjs",
    "test:sessions-browser": "node test/browser/sessions-journey.mjs",
    "test:settlement-browser": "node test/browser/settlement-journey.mjs",
    "test:authorization-browser": "node test/browser/authorization-journey.mjs",
    "test:clearing-browser": "node test/browser/clearing-journey.mjs",
    "test:backend-browser": "node test/browser/backend-journey.mjs",
    "db:migrate": "node scripts/db.ts migrate",
    "db:status": "node scripts/db.ts status",
    "db:seed-demo": "node scripts/db.ts seed-demo"
  },
  "dependencies": {
    "@stellar/freighter-api": "6.0.1",
    "@stellar/stellar-sdk": "17.4.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
